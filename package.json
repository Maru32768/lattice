{
  "name": "lattice",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:overlay && vite",
    "build": "tsc && npm run build:overlay && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test src/*.test.ts src/overlay/*.test.ts e2e/*.test.ts",
    "e2e": "tsc -p e2e && playwright test",
    "build:overlay": "vite build -c vite.overlay.config.ts",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
