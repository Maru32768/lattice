{
  "name": "lattice",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:overlay && vite",
    "build": "tsc && tsc -p tsconfig.test.json && npm run build:overlay && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test src/**/*.test.ts scripts/*.test.mjs e2e/*.test.ts",
    "bump": "node scripts/version.mjs",
    "e2e": "tsc -p e2e && playwright test",
    "build:overlay": "vite build -c vite.overlay.config.ts",
    "lint": "oxlint --deny-warnings && prettier --check . && node scripts/react-compiler.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@tauri-apps/api": "^2",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
