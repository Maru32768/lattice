{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "browser-overlay",
  "description": "Remote pages in the in-app browser: only the overlay commands (config, translate, snapshot)",
  "webviews": ["browser"],
  "remote": { "urls": ["https://*", "http://*"] },
  "permissions": ["allow-overlay-config", "allow-overlay-translate", "allow-overlay-snapshot"]
}
