{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app UI (local origin only)",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-save-url",
    "allow-save-page",
    "allow-reextract-article",
    "allow-import-urls",
    "allow-list-articles",
    "allow-list-tags",
    "allow-set-favorite",
    "allow-add-tag",
    "allow-remove-tag",
    "allow-get-article",
    "allow-article-for-url",
    "allow-translate-article",
    "allow-summarize-article",
    "allow-search-blocks",
    "allow-set-read",
    "allow-db-path",
    "allow-get-settings",
    "allow-set-claude-model",
    "allow-backup-db",
    "allow-browser-open",
    "allow-browser-set-bounds",
    "allow-browser-hide",
    "allow-browser-go",
    "allow-browser-set-translation"
  ]
}
