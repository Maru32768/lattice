{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice",
  "identifier": "dev.marulabs.lattice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "pwsh -NoProfile -File scripts/prepare-windows-bundle.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lattice",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCMkEzQkE4NDEwNkRGMjUKUldRbDN3WkJxRHNxZS85V2QzNEJ1OUlCeXEwQlBGTTVUZFFqRUQxdERnM1oycFVDcE1YeDJNRlgK",
      "endpoints": [
        "https://github.com/Maru32768/lattice/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "targets": [
      "nsis"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
